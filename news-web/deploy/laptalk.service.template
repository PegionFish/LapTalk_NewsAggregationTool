[Unit]
Description=LapTalk 新闻知识聚合中心
Documentation=https://github.com/PegionFish/LapTalk_NewsAggregationTool
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User={{USER}}
Group={{USER}}
WorkingDirectory={{PROJECT_ROOT}}/news-web/backend
Environment=PATH=/usr/bin:/usr/local/bin:/home/{{USER}}/.local/bin
Environment=NEWS_WEB_TESTING=0
ExecStart=/usr/bin/python3 main.py
Restart=always
RestartSec=10

# 日志 — 同时输出到 journald 和文件
StandardOutput=append:{{PROJECT_ROOT}}/logs/backend.log
StandardError=append:{{PROJECT_ROOT}}/logs/backend.log

# 安全加固
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=full
ProtectHome=read-only
ReadWritePaths={{PROJECT_ROOT}}/news-web/backend/data
ReadWritePaths={{PROJECT_ROOT}}/logs

# 资源限制
LimitNOFILE=4096

[Install]
WantedBy=multi-user.target
